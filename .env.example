# Arena Órion — variáveis de ambiente.
# O ./start.sh cria um .env real a partir deste modelo na primeira execução,
# gerando segredos aleatórios. NÃO versione o .env (ele está no .gitignore).

# Segredo mestre da arena. Dele saem as SENHAS e as FLAGS de cada equipe.
# O MESMO valor vai para o alvo (gera as flags) e para o CTFd (valida as flags).
# Se mudar depois de distribuir as credenciais, tudo muda. Guarde com cuidado.
ORION_TEAM_SECRET=troque-por-um-segredo-aleatorio-forte

# Quantas equipes criar no CTFd (equipe01 .. equipeNN).
NUM_EQUIPES=20

# Admin do CTFd (professor).
CTFD_ADMIN_USER=professor
CTFD_ADMIN_PASS=troque-esta-senha-admin
CTFD_ADMIN_EMAIL=rsm2@cesar.org.br
CTF_NOME=Arena Órion

# Segredos de infraestrutura (gerados pelo start.sh).
CTFD_SECRET_KEY=troque
DB_PASSWORD=troque
DB_ROOT_PASSWORD=troque
